# Local tool state — machine-specific, never project content
.claude/settings.local.json

# Raw acquired content — MUST NEVER be committed (ADR-0044, REQ-1102, REQ-1107)
# Scraped article text, MCX/calendar page content and Firecrawl payloads are
# third-party copyrighted work. This ignore is the first line of defence; the
# pre-commit hook (T0.5) is the enforced one.
raw/
**/raw/
cassettes/
**/cassettes/
*.parquet

# Secrets
.env
.env.*
# The template is the one exception: names only, never values — and the
# pre-commit hook verifies that emptiness rather than assuming it.
!.env.example
*.pem
*.key
credentials.json

# SAM build output — regenerated by `sam build`, never committed
.aws-sam/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Model weights — baked into the container image, not the repo
weights/
*.safetensors
*.bin

# Node / frontend
node_modules/
.parcel-cache/

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Power-analysis working data — fetched, never committed (ADR-0044)
docs/analysis/power/fred/
docs/analysis/power/*.npy
docs/analysis/power/results.txt

# Acquired price/market data — fetched locally, never committed (ADR-0044, REQ-1107).
# Commit the FETCHER, not the data. If a source is public-domain or CC-BY, that is a
# deliberate exception recorded in DATA_SOURCES.md, not a default.
**/data/
# Git never descends into an excluded DIRECTORY, so a negation written inside
# one is dead on arrival. The files we do publish need the directory itself
# re-included first and its contents excluded by pattern — the same shape the
# ui/data/ block below already uses. Subdirectories (runner_logs/, reasoning/)
# stay excluded by `data/*`, which is what we want.
!data/
data/*
!data/README.md
!docs/analysis/**
*.csv
!docs/**/*.csv
# The knowledge-time ledger is OUR observation of when each FRED value became
# readable — dates only, no source values — and without it every join falls back
# to the conservative bound. Committed as derived work (REQ-1106).
#
# This negation MUST stay below `*.csv`. Above it, that line silently re-excluded
# the ledger; together with the dead directory negation that stood here until
# 2026-08-20 it meant the file was never once committable, despite the docstring
# in gold_poc_data.py saying it was committed on purpose. Two rules, one file,
# both wrong, and nothing failed loudly to say so.
!data/fred_first_seen.csv

# The dashboard's generated record is the one deliberate exception to **/data/:
# it is OUR derived work — scores, probabilities, verdicts — which REQ-1106
# publishes. Admitted BY NAME: the price layers (ui/data/prices*.js and
# ui/data/live_prices.js, the P8e sidecar) must stay local — they carry
# CBR-derived price values and the CBR terms question in DATA_SOURCES.md is
# still open (ADR-0044/ADR-0050). The page degrades gracefully without them.
!ui/data/
ui/data/*
!ui/data/results.js
!ui/data/results_usd_rub.js
!ui/data/results_usd_inr.js
!ui/data/results_wti.js
!ui/data/results_silver.js
!ui/data/latest.js
!ui/data/live.js
!ui/data/events.js
!ui/data/wiki.js

# Python bytecode from the analysis scripts
__pycache__/

# Stray probe output from research passes — never repo content
/bbmeta.txt
/bcb4.json
/x1.json
*.probe.json
