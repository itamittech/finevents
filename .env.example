# FinEvents — local environment template.
#
# Copy this file to `.env` and fill in your values:
#
#     cp .env.example .env        (or copy .env.example .env on Windows)
#
# `.env` is gitignored and additionally blocked by the pre-commit hook, so your
# values cannot reach the repository. This example file is committed on purpose
# and the same hook verifies it carries names only — a commit fails if any
# variable here ever has a value.

# Required for the reasoning rung (P8c, ADR-0057). Without it the daily runner
# still seals every numeric method and visibly skips the LLM rung.
OPENAI_API_KEY=

# Optional. The reasoning model id; empty means the default (gpt-5.6-sol).
FINEVENTS_LLM_MODEL=
